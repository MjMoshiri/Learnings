#!/usr/bin/env bash
# Usage: bin/new-note <topic> <slug>
# Creates topics/live/<topic>/<slug>.md with frontmatter.

set -e

if [ $# -lt 2 ]; then
  echo "usage: $0 <topic> <slug>" >&2
  exit 1
fi

topic="$1"
slug="$2"
repo_root="$(cd "$(dirname "$0")/.." && pwd)"

note_path="$repo_root/topics/live/$topic/$slug.md"

mkdir -p "$repo_root/topics/live/$topic"

if [ -e "$note_path" ]; then
  echo "exists: $note_path" >&2
  exit 1
fi

title=$(echo "$slug" | tr '-' ' ')

cat > "$note_path" <<EOF
---
topic: $topic
status: wip
---

# $title

EOF

echo "created: $note_path"
