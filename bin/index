#!/usr/bin/env bash
# Regenerates topics/_.md from the topics/ folder structure.
# Lists every topic and its files. Hand-edit topics/<topic>/_.md for richer landing pages.

set -e

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
out="$repo_root/topics/_.md"

{
  echo "# Topics"
  echo ""
  echo "Auto-generated by \`bin/index\`. Each topic folder may have its own \`_.md\` landing page."
  echo ""
  for dir in "$repo_root"/topics/*/; do
    topic=$(basename "$dir")
    count=$(find "$dir" -maxdepth 1 -name "*.md" ! -name "_.md" | wc -l | tr -d ' ')
    echo "## $topic ($count)"
    echo ""
    for f in "$dir"*.md; do
      [ -e "$f" ] || continue
      base=$(basename "$f" .md)
      if [ "$base" = "_" ]; then
        echo "- [_.md]($topic/_.md) — landing"
      else
        echo "- [$base.md]($topic/$base.md)"
      fi
    done
    echo ""
  done
} > "$out"

echo "wrote: $out"
