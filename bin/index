#!/usr/bin/env bash
# Regenerates topics/_.md from the topics/ folder structure.
# Topics live under topics/live/ (active) and topics/archive/ (parked).
# Lists every topic and its files. Hand-edit topics/<tier>/<topic>/_.md for richer landing pages.

set -e

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
out="$repo_root/topics/_.md"

section() {
  tier="$1"
  title="$2"
  [ -d "$repo_root/topics/$tier" ] || return 0
  echo "# $title"
  echo ""
  for dir in "$repo_root"/topics/"$tier"/*/; do
    [ -e "$dir" ] || continue
    topic=$(basename "$dir")
    count=$(find "$dir" -maxdepth 1 -name "*.md" ! -name "_.md" | wc -l | tr -d ' ')
    echo "## $topic ($count)"
    echo ""
    for f in "$dir"*.md; do
      [ -e "$f" ] || continue
      base=$(basename "$f" .md)
      if [ "$base" = "_" ]; then
        echo "- [_.md]($tier/$topic/_.md) — landing"
      else
        echo "- [$base.md]($tier/$topic/$base.md)"
      fi
    done
    echo ""
  done
}

{
  echo "# Topics"
  echo ""
  echo "Auto-generated by \`bin/index\`. Each topic folder may have its own \`_.md\` landing page."
  echo ""
  section live "Live"
  section archive "Archive"
} > "$out"

echo "wrote: $out"
